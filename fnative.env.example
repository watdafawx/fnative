# Environment for the game process: build.py copies this beside factorio-native.exe as fnative.env (once: your own
# edits are kept), and the launcher reads it at every start. One KEY=value per line.

# Python modules Lua can call (native.call("py", "module:function", input)), ';'-separated: the dashboard's tools in
# this repo's py folder, then any of your own
FNATIVE_PYPATH={FNATIVE_PY}

# the game's mods folder, when it isn't %APPDATA%\Factorio\mods (the mod manager page and the startup report read it)
# FACTORIO_MODS=D:\Factorio\mods

# the local web API's port (127.0.0.1 only)
FNATIVE_WEB_PORT=8790

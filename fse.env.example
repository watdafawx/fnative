# Environment for the game process, read from fse.env at every start (optional: without it the defaults apply).
# In a release this file is fse.env.example: copy it to fse.env to use it.
# One KEY=value per line.

# more Python modules Lua can call (native.call("py", "module:function", input)), ';'-separated; fse's own py
# folder is always there
# FSE_PYPATH=C:\path\to\my\python\modules

# the game's mods folder, when it isn't the one the game's config says (the mod manager page reads it)
# FACTORIO_MODS=D:\Factorio\mods

# the local web API's port (127.0.0.1 only)
FSE_WEB_PORT=8790
